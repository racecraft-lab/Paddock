{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racecraft-lab.github.io/Paddock/schemas/repo-knowledge-index.schema.json",
  "title": "Paddock Repo Knowledge Index",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "last_verified", "entries"],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "last_verified": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "purpose",
        "owner",
        "freshness",
        "last_verified",
        "related_specs",
        "verification_commands"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "durable-intent",
            "execution-ledger",
            "status-pointer",
            "qa-evidence",
            "rollback-runbook",
            "operator-tooling",
            "contract"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "freshness": {
          "$ref": "#/$defs/freshness"
        },
        "last_verified": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "related_specs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^SPEC-[0-9]{3}[A-Z0-9]*$"
          }
        },
        "verification_commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": {
          "type": "boolean"
        },
        "repo_owned": {
          "type": "boolean"
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          }
        }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cadence", "trigger"],
      "properties": {
        "cadence": {
          "type": "string",
          "minLength": 1
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "stale_after_days": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "required", "repo_owned"],
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "repo_owned": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        }
      }
    }
  }
}
