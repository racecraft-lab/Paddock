{
  "name": "paddock-installer",
  "version": "1.0.0",
  "description": "Install and configure Paddock — the OpenClaw agent orchestration dashboard",
  "author": "Builderz Labs",
  "license": "MIT",
  "tools": ["exec", "fs"],
  "parameters": {
    "deployment_mode": {
      "type": "string",
      "enum": ["docker", "local"],
      "default": "docker",
      "description": "How to deploy Paddock"
    },
    "port": {
      "type": "number",
      "default": 3000,
      "description": "Port for the Paddock dashboard"
    },
    "install_dir": {
      "type": "string",
      "default": "",
      "description": "Installation directory (defaults to ./paddock)"
    }
  },
  "tags": ["paddock", "dashboard", "installer", "docker"]
}
