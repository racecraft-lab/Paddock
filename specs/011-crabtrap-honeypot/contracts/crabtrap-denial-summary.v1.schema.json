{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racecraft-lab.local/contracts/crabtrap-denial-summary.v1.schema.json",
  "title": "CrabTrap Denial Summary v1",
  "description": "Helper-only SPEC-011 fixture contract. This is not a runtime route, webhook, OpenAPI path, admin-polling shape, or notification contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "event_id",
    "signed_at",
    "occurred_at",
    "decision",
    "method",
    "url_host",
    "url_path",
    "reason_code",
    "safe_request_hash",
    "denial_count",
    "actor_kind",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "const": "crabtrap_denial_summary.v1"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "signed_at": {
      "type": "string",
      "format": "date-time"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "decision": {
      "const": "deny"
    },
    "method": {
      "type": "string",
      "enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"]
    },
    "url_host": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[a-z0-9.-]+$"
    },
    "url_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^/[^?#\\r\\n]*$"
    },
    "reason_code": {
      "type": "string",
      "enum": [
        "static_rule_denied",
        "llm_policy_denied",
        "fallback_denied",
        "ssrf_blocked",
        "rate_limited",
        "policy_denied",
        "unknown_denied"
      ]
    },
    "safe_request_hash": {
      "$ref": "#/$defs/sha256_colon_hash"
    },
    "denial_count": {
      "$ref": "#/$defs/safe_count"
    },
    "actor_kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_:-]{0,63}$"
    },
    "signature": {
      "type": "string",
      "pattern": "^sha256=[a-f0-9]{64}$"
    },
    "source_instance_hash": {
      "$ref": "#/$defs/sha256_colon_hash"
    },
    "actor_ref_hash": {
      "$ref": "#/$defs/sha256_colon_hash"
    },
    "workspace_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "project_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "probe_kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_:-]{0,63}$"
    },
    "url_path_hash": {
      "$ref": "#/$defs/sha256_colon_hash"
    },
    "distinct_host_count": {
      "$ref": "#/$defs/safe_count"
    },
    "distinct_path_count": {
      "$ref": "#/$defs/safe_count"
    },
    "distinct_actor_count": {
      "$ref": "#/$defs/safe_count"
    }
  },
  "$defs": {
    "sha256_colon_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "safe_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    }
  }
}
